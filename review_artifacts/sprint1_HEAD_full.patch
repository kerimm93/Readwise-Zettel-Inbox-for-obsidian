+  });
+}
+
+/* ============================================================
+   ATOMIC NOTE (ZETTEL) MODAL
+   ============================================================ */
+function updatePath() {
+  var p = byId('zParent').value.trim();
+  var k = byId('zKuerzel').value.trim();
+  var el = byId('zPath');
