+  el.innerHTML = (p ? esc(p) : '<span class="ph">parent</span>') + '<span class="ph">.</span>' + (k ? '<b>' + esc(k) + '</b>' : '<span class="ph">kürzel</span>');
+}
+function openNoteModal(h) {
+  currentHighlightId = h.id;
+  byId('zParent').value = '';
+  var firstWords = h.text.split(/\s+/).slice(0, 4).join(' ').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+  byId('zKuerzel').value = firstWords.slice(0, 24);
+  byId('zTitel').value = (h.source_author ? h.source_author + ' — ' : '') + h.text.split(/\s+/).slice(0, 6).join(' ') + (h.text.split(/\s+/).length > 6 ? '…' : '');
+  byId('zSummary').value = '';
+  byId('zAnm').value = h.note || '';
+  byId('zZitat').value = h.text;
+  byId('zSrc').value = (h.source_author || '?') + ': ' + (h.source_title || '?');
