+
+.step-label { font-family: var(--label); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--ink-light); margin: 18px 0 9px; display: flex; align-items: center; gap: 8px; }
+.step-label .num { width: 22px; height: 22px; border-radius: 50%; background: var(--ink); color: var(--bg); display: grid; place-items: center; font-size: 11px; flex: none; }
+
+/* path display (zettel) */
+.path-display { font-family: var(--mono); font-size: 14px; color: var(--ink); background: var(--bg); border: 1.5px dashed var(--border); border-radius: 6px; padding: 11px 13px; margin-top: -4px; }
+.path-display .ph { color: var(--ink-dim); }
+.path-display b { color: var(--gold); font-weight: 600; }
+
+/* memrise preview cards */
+.mcard { border: 1px solid var(--border); border-radius: 6px; padding: 13px 15px; margin-bottom: 10px; background: var(--bg); position: relative; }
+.mcard .mc-x { position: absolute; top: 8px; right: 9px; width: 28px; height: 28px; border-radius: 6px; display: grid; place-items: center; color: var(--ink-light); font-size: 18px; background: var(--surface-2); }
+.mcard .mc-x:hover { color: var(--red); }
+.mcard .mc-row { font-size: 13.5px; margin-bottom: 4px; font-family: var(--label); padding-right: 30px; }
+.mcard .mc-row .k { font-weight: 700; color: var(--ink-light); }
+.mcard .mc-row .v { color: var(--ink); }
+.parse-err { background: rgba(158,42,43,0.08); border: 1px solid rgba(158,42,43,0.3); color: var(--red); border-radius: 6px; padding: 11px 13px; font-size: 13px; font-family: var(--label); margin-bottom: 10px; }
+
+/* ============ TOASTS ============ */
+.toasts { position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 200; display: flex; flex-direction: column; gap: 10px; width: calc(100% - 36px); max-width: 460px; pointer-events: none; }
+.toast { background: var(--ink); border-radius: 7px; border-left: 4px solid var(--blue); padding: 13px 16px; font-size: 14px; color: var(--bg); font-family: var(--label); box-shadow: 0 12px 30px rgba(44,36,22,0.32); display: flex; align-items: center; gap: 10px; animation: slideUp .25s ease; pointer-events: auto; }
+.toast.ok { border-left-color: var(--green); }
+.toast.err { border-left-color: var(--red); }
+.toast.warn { border-left-color: var(--gold-light); }
