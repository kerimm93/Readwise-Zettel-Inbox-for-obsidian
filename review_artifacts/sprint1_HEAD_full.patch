+<script>
+"use strict";
+
+/* ============================================================
+   CONSTANTS
+   ============================================================ */
+var DB_NAME = 'readwise-inbox-v1';
+var DB_VERSION = 1;
+var STORES = ['highlights', 'cards', 'zettels', 'config'];
+var TOKEN_KEY = 'readwise-inbox-token';
+var GIST_TOKEN_KEY = 'readwise-inbox-gist-token';
+var ANKI_ENDPOINT = 'http://localhost:8765';
+var READWISE_API = 'https://readwise.io/api/v3/list/';
+
+var MODELS = {
+  mastery: 'Mastery-Notiztyp',
+  mc: 'Memrise (Lτ) Preset [Translation+Listenting | MultipleChoice+Typing] v5.1',
+  tapping: 'Memrise (Lτ) Preset [Translation+Listenting | MultipleChoice+Typing] v5.1',
+  cloze: 'Memrise (Lτ) Cloze Template v5.1'
+};
+
+var db = null;
+var config = null;
+var currentHighlightId = null;
+var memSubtype = 'mc';
+var memCards = [];
+
+/* ============================================================
+   INDEXEDDB WRAPPER  (unverändert)
+   ============================================================ */
+function openDB() {
+  return new Promise(function (resolve, reject) {
+    var req = indexedDB.open(DB_NAME, DB_VERSION);
+    req.onupgradeneeded = function (e) {
+      var d = e.target.result;
+      STORES.forEach(function (s) {
+        if (!d.objectStoreNames.contains(s)) d.createObjectStore(s, { keyPath: 'id' });
+      });
+    };
+    req.onsuccess = function () { resolve(req.result); };
+    req.onerror = function () { reject(req.error); };
+  });
+}
+function tx(store, mode) { return db.transaction(store, mode).objectStore(store); }
+function idbPut(store, val) {
+  return new Promise(function (res, rej) {
+    var r = tx(store, 'readwrite').put(val);
+    r.onsuccess = function () { res(val); };
+    r.onerror = function () { rej(r.error); };
+  });
+}
+function idbGet(store, key) {
+  return new Promise(function (res, rej) {
+    var r = tx(store, 'readonly').get(key);
+    r.onsuccess = function () { res(r.result); };
+    r.onerror = function () { rej(r.error); };
+  });
+}
+function idbAll(store) {
+  return new Promise(function (res, rej) {
+    var r = tx(store, 'readonly').getAll();
+    r.onsuccess = function () { res(r.result || []); };
+    r.onerror = function () { rej(r.error); };
+  });
+}
+
+/* ============================================================
+   CONFIG
+   ============================================================ */
+function defaultConfig() {
+  return {
+    id: 'singleton',
+    mastery_deck: 'Mastery',
+    memrise_deck: 'Memrise Inbox',
+    gist_id: '',
+    last_readwise_cursor: ''
+  };
+}
+function loadConfig() {
+  return idbGet('config', 'singleton').then(function (c) {
+    config = Object.assign(defaultConfig(), c || {});
+    config.id = 'singleton';
+    if (!config.mastery_deck) config.mastery_deck = 'Mastery';
+    if (!config.memrise_deck) config.memrise_deck = 'Memrise Inbox';
+    return idbPut('config', config);
+  });
+}
+function saveConfig() { return idbPut('config', config); }
+
+function getToken() { return localStorage.getItem(TOKEN_KEY) || ''; }
+function setToken(v) { localStorage.setItem(TOKEN_KEY, v); }
+function getGistToken() { return localStorage.getItem(GIST_TOKEN_KEY) || ''; }
+function setGistToken(v) { localStorage.setItem(GIST_TOKEN_KEY, v); }
+
+/* ============================================================
+   MOCK SEED  (unverändert)
+   ============================================================ */
+function nowISO() { return new Date().toISOString(); }
+
+var MOCK = [
+  { readwise_id: 90210001, text: 'The first principle is that you must not fool yourself — and you are the easiest person to fool.', note: 'Erinnert an Confirmation Bias. Vor jedem starken Glauben prüfen, ob ich mich selbst täusche.', source_title: 'Surely You\'re Joking, Mr. Feynman!', source_author: 'Richard P. Feynman', source_url: 'https://readwise.io/bookreview/feynman', source_cover: '', category: 'books' },
+  { readwise_id: 90210002, text: 'A complex system that works is invariably found to have evolved from a simple system that worked. A complex system designed from scratch never works and cannot be patched up to make it work. You have to start over, beginning with a working simple system.', note: '', source_title: 'Systemantics', source_author: 'John Gall', source_url: 'https://readwise.io/bookreview/systemantics', source_cover: '', category: 'books' },
+  { readwise_id: 90210003, text: 'We are what we repeatedly do. Excellence, then, is not an act, but a habit.', note: 'Gute Karte für tägliche Wiederholung — fragt nach der Quelle (oft Aristoteles zugeschrieben, eigentlich Will Durant).', source_title: 'The Story of Philosophy', source_author: 'Will Durant', source_url: 'https://readwise.io/bookreview/durant', source_cover: '', category: 'books' },
+  { readwise_id: 90210004, text: 'The best way to predict the future is to invent it.', note: '', source_title: 'Alan Kay at PARC', source_author: 'Alan Kay', source_url: 'https://readwise.io/articles/alankay', source_cover: '', category: 'articles' },
+  { readwise_id: 90210005, text: 'Spaced repetition is the deliberate use of the spacing effect: reviewing material at increasing intervals so that each review lands just before you would have forgotten. The cost is small and the payoff compounds — knowledge that would have evaporated becomes permanent at remarkably little ongoing effort.', note: 'Direkt relevant für diese App. Vielleicht eine Cloze-Karte: {{c1::spacing effect}}.', source_title: 'How to Remember Anything Forever-ish', source_author: 'Nicky Case', source_url: 'https://ncase.me/remember/', source_cover: '', category: 'articles' }
+];
+
+function buildHighlight(m) {
+  return {
+    id: 'rw_' + m.readwise_id, readwise_id: m.readwise_id, text: m.text, note: m.note || '',
+    source_title: m.source_title || '', source_author: m.source_author || '', source_url: m.source_url || '',
+    source_cover: m.source_cover || '', highlighted_at: m.highlighted_at || nowISO(), category: m.category || '',
+    readwise_url: m.readwise_url || ('https://readwise.io/highlights/' + m.readwise_id),
+    status: 'inbox', loadedAt: nowISO(), updatedAt: nowISO()
+  };
+}
+function seedIfEmpty() {
+  return idbAll('highlights').then(function (all) {
+    if (all.length > 0) return;
+    var chain = Promise.resolve();
+    MOCK.forEach(function (m) { chain = chain.then(function () { return idbPut('highlights', buildHighlight(m)); }); });
+    return chain;
+  });
+}
+
+/* ============================================================
+   UTIL
+   ============================================================ */
+function esc(s) {
+  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+}
+function slugify(s) {
+  return String(s || 'note').toLowerCase().trim().replace(/[^a-z0-9äöüß\s_-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').slice(0, 60) || 'note';
+}
+function byId(id) { return document.getElementById(id); }
+function loading(on) { byId('loadingBar').classList.toggle('on', on); }
+
+function toast(msg, type) {
+  var box = byId('toasts');
+  var el = document.createElement('div');
+  el.className = 'toast ' + (type || '');
+  el.textContent = msg;
+  box.appendChild(el);
