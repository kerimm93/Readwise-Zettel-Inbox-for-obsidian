+  if (h.category) med.push('Kategorie: ' + esc(h.category));
+  var medHtml = med.join(' &nbsp;|&nbsp; ');
+  if (h.source_url) medHtml += '<br><a href="' + esc(h.source_url) + '" target="_blank" rel="noopener">📚 Alle Highlights dieser Quelle →</a>';
+  if (h.source_cover) medHtml += '<img class="cover-thumb" src="' + esc(h.source_cover) + '" alt="cover">';
+  byId('cMedien').innerHTML = medHtml || '—';
+  openModal('masteryModal');
+}
+function sendMastery() {
+  idbGet('highlights', currentHighlightId).then(function (h) {
+    if (!h) return;
+    var fields = { frage: byId('mFrage').value.trim(), antwort: byId('mAntwort').value.trim(), notizen: byId('cNotizen').value.trim() };
+    if (!fields.frage || !fields.antwort) { toast('Frage und Antwort ausfüllen.', 'warn'); return; }
+    pushMastery(h, fields);
+  });
+}
+
+/* ============================================================
+   MEMRISE MODAL  (HITL)
+   ============================================================ */
+function buildMemrisePrompt(h, subtype) {
+  var base = 'Highlight:\n"' + h.text + '"\nQuelle: ' + h.source_author + ' — ' + h.source_title + '\n\n';
+  if (subtype === 'mc') {
+    return base + 'Erstelle eine MC+Typing Anki-Karte im Format:\nLearnable: [Begriff]\nDefinition: [Frage]\nChoices: [richtig|falsch1|falsch2|falsch3]\nAttributes: [Thema]\nExtra: [Erklärung]\n\nNur JSON, kein Fließtext.';
+  }
+  if (subtype === 'tapping') {
+    return base + 'Erstelle eine Tapping+Typing Anki-Karte im Format:\nLearnable Sentence: [vollständiger Satz]\nDefinition: [Frage]\nChoices: [Satz korrekt|Variante1|Variante2]\nAttributes: [Thema]\nExtra: [Erklärung]\n\nNur JSON, kein Fließtext.';
+  }
+  if (subtype === 'cloze') {
+    return base + 'Erstelle eine Cloze Anki-Karte im Format:\nText: [Satz mit {{c1::Lücke}}]\nChoices: [richtig|falsch1|falsch2]\nAttributes: [Thema]\nExtra: [Erklärung]\n\nNur JSON, kein Fließtext.';
+  }
+}
+function openMemriseModal(h) {
+  memSubtype = 'mc';
+  memCards = [];
+  document.querySelectorAll('#memSeg button').forEach(function (b) { b.classList.toggle('active', b.dataset.sub === 'mc'); });
+  byId('memResult').value = '';
+  byId('memPreview').innerHTML = '';
+  byId('btnSendMemrise').disabled = true;
+  byId('memDeckHint').textContent = 'Ziel-Deck: ' + (config.memrise_deck || 'Memrise Inbox');
+  refreshPrompt(h);
+  openModal('memriseModal');
+}
+function refreshPrompt(h) {
+  var labels = { mc: 'Prompt für KI — Memrise MC+Typing', tapping: 'Prompt für KI — Memrise Tapping+Typing', cloze: 'Prompt für KI — Memrise Cloze' };
+  byId('promptLbl').textContent = labels[memSubtype];
+  byId('promptText').textContent = buildMemrisePrompt(h, memSubtype);
+}
+function normalizeKeys(obj) {
+  var out = {};
+  Object.keys(obj).forEach(function (k) {
+    var nk = k.toLowerCase().trim();
+    if (nk === 'learnable sentence') nk = 'learnable';
+    if (nk === 'text' || nk === 'cloze') nk = 'text';
+    out[nk] = typeof obj[k] === 'string' ? obj[k] : String(obj[k]);
+  });
+  return out;
+}
+function parseMemriseResult() {
+  var raw = byId('memResult').value.trim();
+  byId('memPreview').innerHTML = '';
+  byId('btnSendMemrise').disabled = true;
+  memCards = [];
+  if (!raw) { toast('Bitte zuerst das KI-Ergebnis einfügen.', 'warn'); return; }
+  var txt = raw.replace(/```json/gi, '').replace(/```/g, '').trim();
+  // grab first {...} or [...] block
+  var first = txt.search(/[\[{]/);
+  if (first > 0) txt = txt.slice(first);
+  var data;
+  try { data = JSON.parse(txt); }
+  catch (e) {
+    byId('memPreview').innerHTML = '<div class="parse-err">JSON konnte nicht gelesen werden: ' + esc(e.message) + '. Stelle sicher, dass die KI reines JSON zurückgibt.</div>';
+    return;
+  }
+  var arr = Array.isArray(data) ? data : [data];
+  var valid = [];
+  arr.forEach(function (o) {
+    if (!o || typeof o !== 'object') return;
+    var n = normalizeKeys(o);
+    if (memSubtype === 'cloze') {
+      if (n.text && n.text.indexOf('{{c') >= 0) valid.push(n);
+    } else {
+      if (n.learnable) valid.push(n);
+    }
+  });
+  if (valid.length === 0) {
+    byId('memPreview').innerHTML = '<div class="parse-err">Keine gültigen Karten gefunden. Erwartet: ' + (memSubtype === 'cloze' ? '"Text" mit {{c1::…}}' : '"Learnable" je Karte') + '.</div>';
+    return;
+  }
+  memCards = valid;
+  renderMemPreview();
+  byId('btnSendMemrise').disabled = false;
+  toast('✓ ' + valid.length + ' Karte(n) erkannt.', 'ok');
+}
+function renderMemPreview() {
+  var box = byId('memPreview');
+  box.innerHTML = '<div class="step-label"><span class="num">3</span> Vorschau (' + memCards.length + ')</div>';
+  memCards.forEach(function (c, idx) {
+    var el = document.createElement('div');
+    el.className = 'mcard';
+    var rows = '';
+    var order = memSubtype === 'cloze' ? ['text', 'choices', 'attributes', 'extra'] : ['learnable', 'definition', 'choices', 'attributes', 'extra'];
+    order.forEach(function (k) {
+      if (c[k]) rows += '<div class="mc-row"><span class="k">' + k + ':</span> <span class="v">' + esc(c[k]) + '</span></div>';
+    });
+    el.innerHTML = rows + '<button class="mc-x" data-i="' + idx + '">×</button>';
+    el.querySelector('.mc-x').addEventListener('click', function () {
