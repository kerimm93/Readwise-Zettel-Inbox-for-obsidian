+      }).then(function () { if (alsoZip) return exportZip(); });
+  });
+}
+
+/* ============================================================
+   ZETTELKASTEN RENDER
+   ============================================================ */
+function renderZettels(zettels) {
+  var list = byId('zettelList');
+  list.innerHTML = '';
+  if (zettels.length === 0) {
+    list.innerHTML = '<div class="empty"><div class="big">🗂</div><h3>Noch keine Notizen</h3><p>Erstelle Atomic Notes aus deinen Highlights in der Inbox.</p></div>';
+    byId('zExportTop').style.display = 'none';
