+}
+.choice:hover { border-color: var(--gold); background: var(--surface); transform: translateY(-2px); }
+.choice .ci { font-size: 28px; }
+.choice .ct { font-weight: 600; font-size: 17px; font-family: var(--body); color: var(--ink); }
+.choice .cd { font-size: 13px; color: var(--ink-light); font-family: var(--label); }
+
+/* collapsible */
+.collapse { border: 1px solid var(--border); border-radius: 6px; margin-bottom: 12px; overflow: hidden; background: var(--bg); }
+.collapse summary { list-style: none; cursor: pointer; padding: 13px 15px; font-weight: 700; font-size: 14px; font-family: var(--label); display: flex; align-items: center; gap: 9px; color: var(--ink); min-height: 46px; }
+.collapse summary::-webkit-details-marker { display: none; }
