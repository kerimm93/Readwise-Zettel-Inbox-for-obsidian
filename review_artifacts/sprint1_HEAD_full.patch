+.modal-body { padding: 22px; }
+.modal-foot { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; padding: 16px 22px; border-top: 1px solid var(--border); }
+
+.seg { display: flex; gap: 6px; background: var(--bg); border: 1.5px solid var(--border); border-radius: 8px; padding: 4px; }
+.seg button { flex: 1; min-height: 40px; border-radius: 5px; font-weight: 700; font-size: 13px; font-family: var(--label); color: var(--ink-light); }
+.seg button.active { background: var(--ink); color: var(--bg); }
+
+/* choice cards (type chooser) */
+.choices { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
+.choice {
+  text-align: left;
+  border: 1.5px solid var(--border);
+  background: var(--bg);
+  border-radius: 8px;
+  padding: 20px 18px;
