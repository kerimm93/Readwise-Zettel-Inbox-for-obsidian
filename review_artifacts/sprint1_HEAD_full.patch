+    .then(function () { wireEvents(); return renderAll(); })
+    .catch(function (err) { console.error(err); toast('Initialisierung fehlgeschlagen: ' + (err && err.message || err), 'err'); });
+}
+boot();
+</script>
+</body>
+</html>
