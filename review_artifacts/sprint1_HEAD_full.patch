+  return md;
+}
+function exportZip() {
+  if (typeof JSZip === 'undefined') { toast('JSZip nicht geladen.', 'err'); return Promise.resolve(); }
+  loading(true);
+  return idbAll('zettels').then(function (zettels) {
+    if (zettels.length === 0) { loading(false); toast('Keine Zettel zum Exportieren.', 'warn'); return; }
+    var zip = new JSZip();
+    var usedNames = {};
+    var chain = Promise.resolve();
+    zettels.forEach(function (z) {
+      var base = z.k ? slugify(z.k) : slugify(z.t);
+      var name = base;
+      while (usedNames[name]) { name = name + '-1'; }
+      usedNames[name] = 1;
+      zip.file(name + '.md', zettelMarkdown(z));
+      if (!z.obsidian_exported) { z.obsidian_exported = true; chain = chain.then(function () { return idbPut('zettels', z); }); }
