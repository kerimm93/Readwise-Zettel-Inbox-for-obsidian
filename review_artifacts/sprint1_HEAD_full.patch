+    id: 'zettel_' + Date.now(),
+    highlight_id: h.id,
+    p: byId('zParent').value.trim(),
+    k: byId('zKuerzel').value.trim(),
+    t: byId('zTitel').value.trim() || 'Ohne Titel',
+    q: byId('zZitat').value.trim(),
+    n: byId('zAnm').value.trim(),
+    s: byId('zSummary').value.trim(),
+    source_ref: (h.source_author || '?') + ': ' + (h.source_title || '?'),
+    readwise_url: h.readwise_url || '',
+    obsidian_exported: false,
