+  setupClamps();
+}
+function buildCard(h) {
+  var card = document.createElement('article');
+  card.className = 'hl-card' + (h.status === 'processed' ? ' done' : h.status === 'skipped' ? ' skipped' : '');
+  card.dataset.id = h.id;
+  var noteHtml = h.note ? '<div class="hl-note"><span class="ic">💬</span><span>' + esc(h.note) + '</span></div>' : '';
+  var disabled = h.status !== 'inbox' ? 'disabled' : '';
+  card.innerHTML =
+    '<div class="hl-top">' +
+      '<div class="hl-src"><span class="t">' + esc(h.source_title || 'Ohne Titel') + '</span>' +
+        (h.source_author ? '<div class="a">' + esc(h.source_author) + '</div>' : '') +
+      '</div>' + statusPill(h.status) +
+    '</div>' +
+    '<div class="hl-text clamped"><span class="qm">„</span>' + esc(h.text) + '<span class="qm">"</span></div>' +
+    '<span class="hl-more">… mehr anzeigen</span>' +
+    noteHtml +
+    '<div class="hl-actions">' +
+      '<button class="act primary" data-act="card" ' + disabled + '>🃏 Karteikarte</button>' +
+      '<button class="act secondary" data-act="note" ' + disabled + '>📝 Atomic Note</button>' +
+      '<button class="act" data-act="skip" ' + disabled + '>⏭ Skip</button>' +
