+window.goTab = goTab;
+function openDrawer() { byId('drawer').classList.add('open'); byId('drawerBack').classList.add('open'); }
+function closeDrawer() { byId('drawer').classList.remove('open'); byId('drawerBack').classList.remove('open'); }
+
+/* ============================================================
+   WIRE UP
+   ============================================================ */
+function withCurrentHighlight(fn) { idbGet('highlights', currentHighlightId).then(function (h) { if (h) fn(h); }); }
+
+function wireEvents() {
