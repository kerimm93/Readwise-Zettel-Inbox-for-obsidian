+.readonly-box { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 12px 14px; font-size: 14px; color: var(--ink-light); line-height: 1.6; font-family: var(--label); }
+.readonly-box .quote { font-style: italic; color: var(--ink); margin-bottom: 6px; font-family: var(--body); }
+.cover-thumb { max-width: 120px; border-radius: 5px; margin-top: 10px; display: block; border: 1px solid var(--border); }
