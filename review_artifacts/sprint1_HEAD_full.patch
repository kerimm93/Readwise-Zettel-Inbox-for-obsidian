+
+.hl-top { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 13px; }
+.hl-src { flex: 1; min-width: 0; }
+.hl-src .t { font-weight: 600; font-size: 16px; color: var(--ink); }
+.hl-src .a { font-size: 13px; color: var(--ink-light); font-family: var(--label); margin-top: 2px; }
+
+.pill {
+  flex: none;
+  font-family: var(--label);
+  font-weight: 700;
+  font-size: 10px;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  padding: 5px 9px;
+  border-radius: 4px;
+  white-space: nowrap;
+}
+.pill.inbox { background: rgba(184,134,11,0.12); color: var(--gold); border: 1px solid rgba(184,134,11,0.35); }
+.pill.done  { background: rgba(74,124,78,0.12); color: var(--green); border: 1px solid rgba(74,124,78,0.35); }
+.pill.skip  { background: var(--surface-2); color: var(--ink-light); border: 1px solid var(--border); }
+
+.hl-text {
+  font-size: 18px;
+  font-style: italic;
+  font-family: var(--body);
+  line-height: 1.66;
+  color: var(--ink);
+  margin-bottom: 12px;
+  text-wrap: pretty;
+}
+.hl-text .qm { color: var(--ink-dim); font-style: normal; }
+.hl-text.clamped {
+  display: -webkit-box;
+  -webkit-line-clamp: 4;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.hl-more { display: none; color: var(--gold); font-weight: 700; font-size: 13px; font-family: var(--label); margin: -2px 0 12px; }
+.hl-more.show { display: inline-block; }
+
+.hl-note {
+  display: flex;
+  gap: 9px;
+  background: var(--surface-2);
+  border-left: 3px solid var(--rust);
+  border-radius: 0 6px 6px 0;
