+  byId('cZitat').innerHTML = '<div class="quote">„' + esc(h.text) + '"</div>' +
+    '<div>(' + esc(h.source_author || '?') + ', ' + esc(h.source_title || '?') + ') ' +
+    (h.readwise_url ? '<a href="' + esc(h.readwise_url) + '" target="_blank" rel="noopener">📖 Readwise →</a>' : '') + '</div>';
+  byId('cNotizen').value = h.note || '';
+  var med = [];
+  if (h.source_author) med.push('Autor: ' + esc(h.source_author));
