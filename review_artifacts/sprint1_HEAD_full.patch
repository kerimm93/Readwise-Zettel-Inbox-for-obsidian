+    card.querySelector('[data-act="card"]').addEventListener('click', function () { openTypeChooser(h); });
+    card.querySelector('[data-act="note"]').addEventListener('click', function () { openNoteModal(h); });
+    card.querySelector('[data-act="skip"]').addEventListener('click', function () { doSkip(h); });
+  }
+  return card;
+}
+function setupClamps() {
+  document.querySelectorAll('.hl-card').forEach(function (card) {
+    var t = card.querySelector('.hl-text');
+    var more = card.querySelector('.hl-more');
+    if (t.scrollHeight - t.clientHeight > 4) more.classList.add('show');
+  });
+}
+function doSkip(h) { setStatus(h.id, 'skipped').then(function () { toast('Übersprungen.', 'warn'); return renderAll(); }); }
+
+/* ============================================================
+   STEP A — TYPE CHOOSER
+   ============================================================ */
+function openTypeChooser(h) {
+  currentHighlightId = h.id;
+  openModal('typeModal');
+}
+
+/* ============================================================
+   MASTERY MODAL
+   ============================================================ */
