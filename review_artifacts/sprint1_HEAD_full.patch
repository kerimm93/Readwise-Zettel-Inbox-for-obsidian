+    el.style.transition = 'opacity .3s, transform .3s';
+    el.style.opacity = '0'; el.style.transform = 'translateY(10px)';
+    setTimeout(function () { el.remove(); }, 320);
+  }, 3800);
+}
+
+/* ============================================================
+   ANKICONNECT  (ankiRequest + buildMedienFeld unverändert)
+   ============================================================ */
+function ankiRequest(action, params) {
+  return fetch(ANKI_ENDPOINT, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ action: action, version: 6, params: params || {} })
+  }).then(function (r) {
+    if (!r.ok) throw new Error('HTTP ' + r.status);
+    return r.json().catch(function () { throw new Error('Ungültige AnkiConnect-Antwort'); });
+  });
+}
+function buildMedienFeld(h) {
+  var lines = [];
+  if (h.source_author) lines.push('Autor: ' + h.source_author);
+  if (h.source_title) lines.push('Full Title: ' + h.source_title);
+  if (h.category) lines.push('Category: ' + h.category);
+  if (h.source_url) lines.push('<a href="' + h.source_url + '">📚 Alle Highlights dieser Quelle</a>');
+  if (h.source_cover) lines.push('<img src="' + h.source_cover + '" style="max-width:120px">');
+  return lines.join('\n');
+}
+
+function ankiOfflineMsg(err) {
+  var m = String(err && err.message || err);
+  if (m.indexOf('Failed to fetch') >= 0 || m.indexOf('NetworkError') >= 0) return 'AnkiConnect nicht erreichbar — läuft Anki mit dem Plugin?';
+  return 'Anki-Fehler: ' + m;
+}
+
+/* ---- Mastery push ---- */
+function buildMasteryNote(h, fields, deck) {
+  return {
+    deckName: deck,
+    modelName: MODELS.mastery,
+    fields: {
+      Frage: fields.frage,
+      Antwort: fields.antwort,
+      Zitat: '„' + h.text + '" (' + h.source_author + ', ' + h.source_title + ') <a href="' + h.readwise_url + '">📖 Readwise</a>',
+      Notizen: fields.notizen || h.note || '',
+      Medien: buildMedienFeld(h)
+    },
+    tags: ['readwise-inbox']
+  };
+}
+
+function pushMastery(h, fields) {
+  var deck = config.mastery_deck || 'Mastery';
+  loading(true);
+  return ankiRequest('version').then(function () {
+    return ankiRequest('addNote', { note: buildMasteryNote(h, fields, deck) });
+  }).then(function (resp) {
+    if (resp && resp.error) throw new Error(resp.error);
+    var card = { id: 'card_' + Date.now(), highlight_id: h.id, template: 'mastery', fields: fields, deck: deck, anki_note_id: resp ? resp.result : null, pushed_at: nowISO(), createdAt: nowISO() };
+    return idbPut('cards', card).then(function () { return markProcessed(h.id); });
+  }).then(function () {
+    loading(false);
+    toast('✓ Mastery Card an Anki gesendet (Deck: ' + deck + ')', 'ok');
+    closeModal('masteryModal');
+    return renderAll();
+  }).catch(function (err) { loading(false); toast(ankiOfflineMsg(err), 'err'); });
+}
+
+/* ---- Memrise notes ---- */
+function buildMemriseNote(h, subtype, obj, deck) {
+  var rw = '<a href="' + h.readwise_url + '">📖 Readwise</a>';
+  if (subtype === 'cloze') {
+    return {
+      deckName: deck, modelName: MODELS.cloze,
+      fields: { Text: obj.text, Choices: obj.choices || '', Attributes: obj.attributes || '', Extra: obj.extra || '', 'Extra 2': rw, Audio: '', Mems: '' },
+      tags: ['readwise-inbox']
+    };
+  }
+  // mc + tapping share the MultipleChoice+Typing preset
+  return {
+    deckName: deck, modelName: subtype === 'tapping' ? MODELS.tapping : MODELS.mc,
+    fields: { Learnable: obj.learnable, Definition: obj.definition || '', Choices: obj.choices || '', Attributes: obj.attributes || '', Extra: obj.extra || '', 'Extra 2': rw, Audio: '', Mems: '' },
+    tags: ['readwise-inbox']
+  };
+}
+
+function pushMemrise(h, subtype, cards) {
+  var deck = config.memrise_deck || 'Memrise Inbox';
+  loading(true);
+  return ankiRequest('version').then(function () {
+    var notes = cards.map(function (c) { return buildMemriseNote(h, subtype, c, deck); });
+    return ankiRequest('addNotes', { notes: notes });
+  }).then(function (resp) {
+    if (resp && resp.error) throw new Error(resp.error);
+    var ids = resp && resp.result ? resp.result : [];
+    var ok = ids.filter(function (x) { return x != null; }).length;
+    var chain = Promise.resolve();
+    cards.forEach(function (c, i) {
+      chain = chain.then(function () {
+        return idbPut('cards', { id: 'card_' + Date.now() + '_' + i, highlight_id: h.id, template: subtype, fields: c, deck: deck, anki_note_id: ids[i] || null, pushed_at: nowISO(), createdAt: nowISO() });
+      });
+    });
+    return chain.then(function () { return markProcessed(h.id); }).then(function () { return ok; });
+  }).then(function (ok) {
+    loading(false);
+    toast('✓ ' + ok + ' Memrise-Karte(n) an Anki gesendet (Deck: ' + deck + ')', 'ok');
+    closeModal('memriseModal');
+    return renderAll();
+  }).catch(function (err) { loading(false); toast(ankiOfflineMsg(err), 'err'); });
+}
+
+/* ============================================================
+   STATUS (idempotent)
+   ============================================================ */
+function markProcessed(id) { return setStatus(id, 'processed'); }
+function setStatus(id, status) {
+  return idbGet('highlights', id).then(function (h) {
+    if (!h) return;
+    if (h.status === 'processed' || h.status === 'skipped') return;
+    h.status = status; h.updatedAt = nowISO();
+    return idbPut('highlights', h);
+  });
+}
+
+/* ============================================================
+   READWISE FETCH  (Logik unverändert)
+   ============================================================ */
+function mapReadwise(r) {
+  return {
+    id: 'rw_' + r.id, readwise_id: r.id, text: r.content || r.text || '', note: r.note || '',
+    source_title: r.title || '', source_author: r.author || '', source_url: r.source_url || '',
+    source_cover: r.cover_image_url || '', highlighted_at: r.highlighted_at || nowISO(), category: r.category || '',
+    readwise_url: r.url || '', status: 'inbox', loadedAt: nowISO(), updatedAt: nowISO()
+  };
+}
+function fetchReadwise() {
+  var token = getToken();
+  if (!token) { toast('Bitte Readwise-Token in den Einstellungen eintragen.', 'warn'); return Promise.resolve(); }
+  setStatusDot('rwStatus', '', 'Lade…');
+  loading(true);
+  var added = 0;
+  var cursor = config.last_readwise_cursor || '';
+  function page(cur) {
+    var url = READWISE_API + '?category=highlight' + (cur ? '&pageCursor=' + encodeURIComponent(cur) : '');
+    return fetch(url, { headers: { Authorization: 'Token ' + token } }).then(function (r) {
+      if (r.status === 401) throw new Error('401 — Token ungültig');
+      if (!r.ok) throw new Error('HTTP ' + r.status);
+      return r.json();
+    }).then(function (data) {
+      var results = data.results || [];
+      var chain = Promise.resolve();
+      results.forEach(function (raw) {
+        chain = chain.then(function () {
+          return idbGet('highlights', 'rw_' + raw.id).then(function (existing) {
+            if (existing) return;
+            added++; return idbPut('highlights', mapReadwise(raw));
+          });
+        });
+      });
+      return chain.then(function () {
+        config.last_readwise_cursor = data.nextPageCursor || '';
+        return saveConfig().then(function () { return data.nextPageCursor ? data.nextPageCursor : null; });
+      });
+    });
+  }
+  return page(cursor).then(function (next) {
+    loading(false);
+    setStatusDot('rwStatus', 'ok', added + ' neu');
+    if (added > 0) toast('✓ ' + added + ' neue Highlights geladen.', 'ok');
+    else toast('Keine neuen Highlights' + (next ? ' auf dieser Seite — erneut klicken für mehr.' : '.'), 'warn');
+    return renderAll();
+  }).catch(function (err) {
+    loading(false);
+    var m = String(err && err.message || err);
+    setStatusDot('rwStatus', 'bad', 'Fehler');
+    if (m.indexOf('Failed to fetch') >= 0) toast('Readwise nicht erreichbar (CORS/Netz). Token & Verbindung prüfen.', 'err');
+    else toast('Readwise-Fehler: ' + m, 'err');
+  });
+}
+function setStatusDot(id, cls, txt) {
+  var el = byId(id);
+  el.className = 'status-dot ' + (cls || '');
+  el.querySelector('.txt').textContent = txt;
+}
+
+/* ============================================================
+   RENDER INBOX
+   ============================================================ */
+function statusPill(status) {
+  if (status === 'processed') return '<span class="pill done">✓ Done</span>';
+  if (status === 'skipped') return '<span class="pill skip">Übersprungen</span>';
+  return '<span class="pill inbox">Inbox ▸</span>';
+}
+function renderInbox(highlights) {
+  var feed = byId('feed');
+  feed.innerHTML = '';
+  highlights.sort(function (a, b) {
+    var ra = a.status === 'inbox' ? 0 : 1, rb = b.status === 'inbox' ? 0 : 1;
+    if (ra !== rb) return ra - rb;
+    return (b.highlighted_at || '').localeCompare(a.highlighted_at || '');
+  });
+  if (highlights.length === 0) {
+    feed.innerHTML = '<div class="empty"><div class="big">✨</div><h3>Inbox leer</h3><p>Keine Highlights vorhanden.</p><button class="btn gold" onclick="goTab(\'settings\')">↓ Highlights laden</button></div>';
+    return;
+  }
+  var inboxCount = highlights.filter(function (h) { return h.status === 'inbox'; }).length;
+  if (inboxCount === 0) {
+    var done = document.createElement('div');
+    done.className = 'empty';
+    done.innerHTML = '<div class="big">✨</div><h3>Inbox leer — alle Highlights verarbeitet.</h3><p>Gut gemacht. Verarbeitete Karten siehst du unten.</p><button class="btn gold" id="reloadBtn">↻ Neue Highlights laden</button>';
+    feed.appendChild(done);
+    var rb = done.querySelector('#reloadBtn');
+    if (rb) rb.addEventListener('click', fetchReadwise);
+  }
