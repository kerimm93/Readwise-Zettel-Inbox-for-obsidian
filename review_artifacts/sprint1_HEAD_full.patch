+}
+function saveNote(alsoZip) {
+  idbGet('highlights', currentHighlightId).then(function (h) {
+    if (!h) return;
+    var z = buildZettelFromModal(h);
+    if (!z.t) { toast('Titel ausfüllen.', 'warn'); return; }
+    return idbPut('zettels', z).then(function () { return markProcessed(h.id); })
+      .then(function () {
+        toast('✓ Atomic Note gespeichert.', 'ok');
+        closeModal('noteModal');
