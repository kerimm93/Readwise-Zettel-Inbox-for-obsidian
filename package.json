{
  "name": "readwise-inbox-obsidian",
  "version": "0.1.0",
  "description": "Readwise Inbox Obsidian plugin bootstrap.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:inbox-state": "node --experimental-strip-types tests/inbox-state-merge.test.ts",
    "test:readwise-fixture": "node --experimental-strip-types tests/readwise-export-fixture.test.ts"
    ,"test:workflow": "node --experimental-strip-types tests/workflow-reflect.test.ts",
    "test:resolution-pagination": "node --experimental-strip-types tests/resolution-pagination.test.ts",
    "test:migration": "node --experimental-strip-types tests/state-migration.test.ts",
    "test": "npm run test:inbox-state && npm run test:readwise-fixture && npm run test:workflow && npm run test:resolution-pagination && npm run test:migration"
  },
  "keywords": [
    "obsidian",
    "readwise",
    "anki"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.3"
  }
}
